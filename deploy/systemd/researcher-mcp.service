[Unit]
Description=Re-Searcher MCP HTTP server (127.0.0.1:8001)
PartOf=researcher.target
After=researcher-chroma.service researcher-vllm.service
Requires=researcher-chroma.service researcher-vllm.service

[Service]
Type=simple
WorkingDirectory=/home/colin/Dev/Re-Searcher
Environment=MCP_HTTP_HOST=127.0.0.1
Environment=MCP_HTTP_PORT=8001
# Don't accept connections until the data + embedding backends actually answer.
ExecStartPre=/home/colin/Dev/Re-Searcher/scripts/researcher_svc.sh wait-backends
ExecStart=/home/colin/Dev/Re-Searcher/.venv/bin/python -m src.mcp_http_server
Restart=on-failure
RestartSec=3

[Install]
WantedBy=researcher.target
